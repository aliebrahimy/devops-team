vrrp_script chk_nginx {
    script "killall -0 nginx"
    interval 2
    weight 2
}
vrrp_instance VI_1 {
    state MASTER
    interface eth0          # نام کارت شبکه را متناسب با محیط تغییر دهید
    virtual_router_id 51
    priority 101
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass rke2secret
    }
    virtual_ipaddress {
        {{ hostvars['localhost']['lb_vip'] }}
    }
    track_script {
        chk_nginx
    }
}
