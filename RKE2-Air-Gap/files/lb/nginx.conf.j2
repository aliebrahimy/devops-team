user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

stream {
    upstream rke2_api {
        server {{ hostvars['localhost']['first_master_ip'] }}:6443 max_fails=3 fail_timeout=30s;
        {% if hostvars['localhost']['additional_masters_ips'] is defined and hostvars['localhost']['additional_masters_ips'] | trim | length > 0 %}
        {% for server in hostvars['localhost']['additional_masters_ips'].split(',') %}
        server {{ server | trim }}:6443 max_fails=3 fail_timeout=30s;
        {% endfor %}
        {% endif %}
    }

    upstream rke2_register {
        server {{ hostvars['localhost']['first_master_ip'] }}:9345 max_fails=3 fail_timeout=30s;
        {% if hostvars['localhost']['additional_masters_ips'] is defined and hostvars['localhost']['additional_masters_ips'] | trim | length > 0 %}
        {% for server in hostvars['localhost']['additional_masters_ips'].split(',') %}
        server {{ server | trim }}:9345 max_fails=3 fail_timeout=30s;
        {% endfor %}
        {% endif %}
    }

    server {
        listen 6443;
        proxy_pass rke2_api;
        proxy_timeout 10m;
        proxy_connect_timeout 2s;
    }

    server {
        listen 9345;
        proxy_pass rke2_register;
        proxy_timeout 10m;
        proxy_connect_timeout 2s;
    }
}
